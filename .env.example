# Copia este archivo como .env y completa los valores.
# El archivo .env no se sube a Git.

# Puertos locales (opcionales)
# PORT=3000
# API_PORT=8080
# API_TARGET=http://localhost:8080
# BASE_PATH=/
NODE_ENV=development

# Supabase > Project Settings > Database > Connection string.
# Usa el "Session pooler" (puerto 5432): la API necesita transacciones y bloqueos de sesión.
DATABASE_URL=

# Supabase > Project Settings > API
SUPABASE_URL=
# Clave secreta (sb_secret_...). Solo para el servidor; nunca con prefijo VITE_.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=attachments

# Mismos datos para el navegador. La clave publicable (sb_publishable_...) es pública por diseño.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Firma de la cookie de analítica. Genera un valor largo y aleatorio.
SESSION_SECRET=

# Dominios desde los que se sirve la app en producción, separados por coma.
# En desarrollo se aceptan localhost y 127.0.0.1 automáticamente.
# ALLOWED_HOSTS=app.midominio.com

# Opcionales
# PILOT_ANALYTICS_KEY=
# LOG_LEVEL=info
